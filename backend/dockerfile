FROM golang:1.27.1-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/api \
    ./cmd/api \
    && CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/seed-rbac \
    ./cmd/seed-rbac \
    && CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/seed-demo \
    ./cmd/seed-demo \
    && mkdir -p /out/private_uploads \
    && chmod 0700 /out/private_uploads

FROM scratch

COPY --from=build /out/api /api
COPY --from=build /out/seed-rbac /seed-rbac
COPY --from=build /out/seed-demo /seed-demo
COPY --from=build --chown=65532:65532 \
    /out/private_uploads /app/private_uploads

WORKDIR /app

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/api"]